# Postgres container (docker-compose.yml)
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=appdb
POSTGRES_PORT=5432

# Pipeline
DATABASE_URL=postgresql://dev:dev@localhost:5432/appdb
LOG_LEVEL=INFO
BATCH_SIZE=1000

# LLM
LLM_PROVIDER=anthropic
# Leave empty to use ANTHROPIC_API_KEY or an `ant auth login` profile instead.
LLM_API_KEY=
CHEAP_MODEL=claude-haiku-5-5
MAIN_MODEL=claude-opus-5-5
# replay: answer only from meta.llm_cache (no key needed; how reviewers run)
# live:   use the cache when it has the request, otherwise call the API and cache it
# record: always call the API and overwrite the cache entry
LLM_MODE=replay
CARD_BUDGET_TOKENS=4000
# chars per token for the estimate when no exact count is available (card --exact)
CARD_CHARS_PER_TOKEN=2
